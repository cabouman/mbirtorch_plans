+    def _view_batch_args(self, device=None):
         """The eager argument dict for this geometry's bodies: every
         parameter read happens HERE, outside the traced region, per call --
-        never frozen at build time (the stale-bind lesson)."""
+        never frozen at build time (the stale-bind lesson).
+
+        ``device`` is the device the bodies will run on for this call; the
+        drivers pass the device of the view parameters they are about to use,
+        so a sharded run gets each device's own copy of any scalar that is
+        handed over as a tensor (see :meth:`_runtime_scalar`).  None means the
+        model's own device, which is what every non-driver caller wants."""
         raise NotImplementedError
 
+    def _runtime_scalar(self, name, value, device=None):
+        """``value`` as a 0-dimensional float32 tensor on ``device``.
+
+        A geometry passes a scalar through this when the scalar must be a
+        RUNTIME input to the compiled bodies rather than a constant baked into
+        them.  torch.compile guards a python float by VALUE -- change the
+        float and the body is traced again -- but it guards a tensor only by
+        dtype, device, shape and layout, all of which are the same for every
+        value here.  So a scalar handed over this way can change as often as
+        the caller likes without costing a single retrace.
+
+        The tensors are memoized per (name, value, device) because the drivers
+        ask for them on every projection call and a fresh allocation plus a
+        four-byte host-to-device copy per call is pure waste when the value
+        almost never changes.  The memo is small and is emptied wholesale once
+        it grows past its cap, so a caller sweeping thousands of values cannot
+        make it grow without bound.
+
+        ``name`` IS PART OF THE KEY, and that is the whole reason it exists:
+        without it two arguments that happen to hold the same number would get
+        the SAME tensor object, and dynamo installs an ALIASING guard on
+        arguments it sees as one object ("det_channel_offset is
+        det_row_offset").  Changing one of the two then breaks that guard and
+        the body is traced again -- exactly the retrace this method removes.
+        Measured on the cone bodies, whose two offsets both default to 0.0.
+        """
+        dev = self.torch_device if device is None else torch.device(device)
+        key = (str(name), float(value), str(dev))
+        cache = getattr(self, '_runtime_scalar_cache', None)
+        if cache is None:
+            cache = self._runtime_scalar_cache = {}
+        hit = cache.get(key)
+        if hit is not None:
+            return hit
+        if len(cache) >= self._RUNTIME_SCALAR_CACHE_MAX:
+            cache.clear()
+        tensor = torch.tensor(float(value), dtype=_F32, device=dev)
+        cache[key] = tensor
+        return tensor
+
+    #: How many (name, value, device) scalars :meth:`_runtime_scalar`
+    #: memoizes before it empties the memo.  One value per scalar per device
+    #: is the steady state; the cap only bounds a sweep.
+    _RUNTIME_SCALAR_CACHE_MAX = 256
+
